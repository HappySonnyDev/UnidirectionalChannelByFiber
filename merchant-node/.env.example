# Fiber Merchant Node Configuration
# Copy this file to .env and fill in your values
# cp .env.example .env

# Merchant Node Private Key (generate with: openssl rand -hex 32)
MERCHANT_PRIVATE_KEY=<your-fiber-node-private-key-hex>

# Merchant node name (optional)
MERCHANT_NODE_NAME=MerchantNode

# CKB Testnet RPC
CKB_RPC_URL=https://testnet.ckbapp.dev/

# Node ports
FIBER_P2P_PORT=8428
FIBER_RPC_PORT=8427
FIBER_WS_PORT=8431

# Announced IP for fiber P2P (used by start-merchant.sh to generate runtime config)
# Set to your server's public IP for deployment, or 127.0.0.1 for local dev
FIBER_ANNOUNCED_IP=54.180.28.237

# WebSocket proxy (for browser WASM node connection)
# Browser WASM node connects via WebSocket proxy to the merchant's P2P port
WS_PROXY_LISTEN=127.0.0.1:18431
WS_PROXY_TARGET=127.0.0.1:8428
