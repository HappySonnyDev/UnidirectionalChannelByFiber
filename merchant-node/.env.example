# Fiber Merchant Node Configuration
# Copy this file to .env and fill in your values
# cp .env.example .env

# Merchant Node Private Key (generate with: openssl rand -hex 32)
MERCHANT_PRIVATE_KEY=

# Merchant node name (optional)
MERCHANT_NODE_NAME=MerchantNode

# CKB Testnet RPC
CKB_RPC_URL=https://testnet.ckbapp.dev/

# Node ports
FIBER_P2P_PORT=8228
FIBER_RPC_PORT=8227
FIBER_WS_PORT=8231

# WebSocket proxy (for browser WASM node connection)
# Browser WASM node connects via WebSocket proxy to the merchant's P2P port
WS_PROXY_LISTEN=0.0.0.0:8231
WS_PROXY_TARGET=127.0.0.1:8228
